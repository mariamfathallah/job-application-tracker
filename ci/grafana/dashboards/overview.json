{
  "uid": "jat-overview",
  "title": "Job Application Tracker - Vue d'ensemble",
  "tags": ["ci-cd", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Cibles en ligne (1 = UP)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "up", "legendFormat": "{{job}} {{environment}}" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] } }
    },
    {
      "id": 2, "type": "timeseries", "title": "Requêtes HTTP par seconde",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (environment) (rate(http_server_requests_seconds_count{job=\"app\"}[5m]))", "legendFormat": "{{environment}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Taux d'erreurs HTTP 5xx",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (environment) (rate(http_server_requests_seconds_count{job=\"app\",status=~\"5..\"}[5m]))", "legendFormat": "{{environment}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "Mémoire JVM utilisée (heap)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (environment) (jvm_memory_used_bytes{job=\"app\",area=\"heap\"})", "legendFormat": "{{environment}}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Durée du dernier build Jenkins",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "default_jenkins_builds_last_build_duration_milliseconds", "legendFormat": "{{jenkins_job}}" } ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
