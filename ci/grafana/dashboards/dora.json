{
  "uid": "jat-dora",
  "title": "DORA - Job Application Tracker",
  "tags": [
    "ci-cd",
    "dora"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "window",
        "label": "Période",
        "type": "custom",
        "query": "7d,30d,all",
        "current": {
          "text": "all",
          "value": "all"
        },
        "options": [
          {
            "text": "7d",
            "value": "7d",
            "selected": false
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          },
          {
            "text": "all",
            "value": "all",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Métriques DORA** calculées automatiquement par `ci/dora-exporter` depuis l'historique Jenkins (stage *Deploy production* de `main`, plus l'historique de `feature/ci-jenkins`) et Git. Couleurs : repères indicatifs des niveaux DORA (vert = élite, rouge = faible). Choisir la période avec la liste **Période** en haut."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fréquence de déploiement",
      "description": "Déploiements réussis en production par jour. Élite : au moins 1 par jour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dora_deployment_frequency_per_day{window=\"$window\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.03333333333333333
              },
              {
                "color": "yellow",
                "value": 0.14285714285714285
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Pas encore de donnée",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Délai de livraison (médiane)",
      "description": "Temps entre un commit et sa mise en production. Élite : moins d'un jour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dora_lead_time_median_seconds{window=\"$window\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "red",
                "value": 2592000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Pas encore de donnée"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taux d'échec des changements",
      "description": "Part des déploiements en production qui échouent (y compris retour arrière automatique du blue/green).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dora_change_failure_rate{window=\"$window\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.15
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.45
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Pas encore de donnée",
          "decimals": 0
        },
        "overrides": []
      }
    },
