# Copier en .env et remplir. Ne JAMAIS committer le fichier .env.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
# JENKINS_PUBLIC_URL=http://localhost:8090/

# SonarQube : token (My Account > Security) + mot de passe admin (pour scripts/bootstrap-sonar.sh)
SONAR_TOKEN=
SONAR_ADMIN_PASSWORD=

# Nexus
NEXUS_USER=admin
NEXUS_PASSWORD=

# GitHub : token fine-grained (voir docs/EQUIPE.md)
GITHUB_USER=
GITHUB_TOKEN=

# Notifications Discord (URL partagée en privé)
DISCORD_WEBHOOK_URL=

# Relais webhook : URL du channel créé sur https://smee.io
SMEE_URL=


# Seul le Jenkins de référence (token GitHub en écriture) publie les releases
RELEASES_ENABLED=false

# Grafana (http://localhost:3000, utilisateur admin)
GRAFANA_ADMIN_PASSWORD=

